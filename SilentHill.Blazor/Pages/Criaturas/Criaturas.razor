@page "/bestiario"
@using SilentHill.Shared
@inject HttpClient Http

<PageTitle>Silent Hill — Bestiário</PageTitle>

<div class="sh-bestiary">
    <div class="sh-bestiary-header">
        <h1 class="sh-bestiary-title">AVISTAMENTOS NA NÉVOA</h1>
        <p class="sh-bestiary-subtitle">Dados coletados diretamente da API de Silent Hill...</p>
    </div>

    @if (listaCriaturas == null)
    {
        <div class="sh-bestiary-loading">
            <div class="spinner-border text-danger" role="status"></div>
            <span>O rádio está emitindo estática...</span>
        </div>
    }
    else if (!listaCriaturas.Any())
    {
        <div class="sh-bestiary-empty">
            <i class="fa-solid fa-radio"></i>
            <p>A cidade parece vazia... Nenhuma criatura detectada pelo radar.</p>
        </div>
    }
    else
    {
        <div class="sh-creature-grid">
            @foreach (var criatura in listaCriaturas)
            {
                <div class="sh-creature-card">
                    <div class="sh-creature-image">
                        @if (!string.IsNullOrEmpty(criatura.ImagemUrl))
                        {
                            <img src="@criatura.ImagemUrl" alt="@criatura.Nome" />
                        }
                        else
                        {
                            <div class="sh-creature-placeholder">
                                <i class="fa-solid fa-eye-slash"></i>
                                <span>SEM SINAL</span>
                            </div>
                        }
                    </div>

                    <div class="sh-creature-body">
                        <h3 class="sh-creature-name">@criatura.Nome</h3>
                        <p class="sh-creature-origin">Origem: @criatura.JogoOrigem</p>
                        <p class="sh-creature-desc">@criatura.Descricao</p>

                        <div class="sh-creature-danger">
                            <span>Perigo:</span>
                            @for (int i = 0; i < criatura.NivelPerigo; i++)
                            {
                                <i class="fa-solid fa-skull"></i>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<CriaturaDto>? listaCriaturas;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            listaCriaturas = await Http.GetFromJsonAsync<List<CriaturaDto>>("api/criaturas");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao sintonizar rádio: {ex.Message}");
        }
    }
}